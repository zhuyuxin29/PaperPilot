# PaperPilot 配置模板：复制为 .env 后填写，.env 不提交到 Git。

# 数据目录（放在仓库外，避免把论文与索引提交进 Git）；留空则使用 %LOCALAPPDATA%\PaperPilot
# 本机示例：PAPERPILOT_DATA_DIR=D:\VsCodeProjects\PaperPilotData
PAPERPILOT_DATA_DIR=

# 图谱开关：off（默认，不需要 Neo4j）/ auto / on
GRAPH_MODE=off

# 前端运行模式：direct（Streamlit 直连业务层）/ http（调用 FastAPI 后端）
PAPERPILOT_API_MODE=direct
PAPERPILOT_API_URL=http://127.0.0.1:8000

# 向量后端：numpy（默认）/ chroma（需 pip install -e ".[chroma]"）
VECTOR_BACKEND=numpy

# 对话模型（模块 2 之后才会用到）
CHAT_PROVIDER=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# Embedding（模块 8）：硅基流动 OpenAI 兼容接口 × BAAI/bge-m3
# 取值：siliconflow（硅基流动/OpenAI 兼容）、hash（仅开发测试，无任何语义）
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024

# Neo4j（仅在 GRAPH_MODE 为 auto/on 时需要）
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Agent 预算（模块 5 之后才会用到）
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=240

# 可选的检索规则词面加权（0=默认纯 RRF；最大 0.05，开启后评测设置需记录）
RETRIEVAL_TERM_BOOST=0
